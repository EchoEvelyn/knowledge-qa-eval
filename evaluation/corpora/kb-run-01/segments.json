      "source_document": "02-network-and-vpn.txt",
      "content": "虚构测试资料：本文为“星河示例科技”知识库 Demo 人工编写，不代表真实网络配置；网络名称和系统名称均为测试设定。",
      "evidence_sha256": "0a927f75855b35295e26b01d0639826881cb8fdfac15347cf68e7ffe769e439d",
      "position": 2
    },
    {
      "stable_id": "dify:d97144f0-a39e-433b-aea3-5f4c935aa688:dfc9f89f-4dd6-4a58-b564-9c6162958d69:8bb94762-4f71-4d99-a600-da4c3d7f4968",
