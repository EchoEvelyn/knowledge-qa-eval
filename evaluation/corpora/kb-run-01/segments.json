      "position": 1
    },
    {
      "stable_id": "dify:d97144f0-a39e-433b-aea3-5f4c935aa688:dfc9f89f-4dd6-4a58-b564-9c6162958d69:ab993f2b-95cc-434e-8879-29990d8288ee",
      "dataset_id": "d97144f0-a39e-433b-aea3-5f4c935aa688",
      "document_id": "dfc9f89f-4dd6-4a58-b564-9c6162958d69",
