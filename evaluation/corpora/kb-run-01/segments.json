      "position": 6
    },
    {
      "stable_id": "dify:d97144f0-a39e-433b-aea3-5f4c935aa688:759c7ae2-7e71-4e5a-bd60-a4aa00c6e148:b97327ea-90d4-4022-ba7a-3fa35cf439ea",
